# Neon Postgres (Vercel > Storage > Neon, oder neon.tech > Connection string)
DATABASE_URL=postgres://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Öffentliche URL der Website (für SEO, Sitemap, hreflang)
NEXT_PUBLIC_SITE_URL=https://azadbedran.com

# Nur für Vorschauen: zeigt Beispiel-Konzerte/-Inhalte mit DEMO-Markierung
# SHOW_DEMO_CONTENT=1

# Admin-Bereich (/admin): Passwort, mindestens 8 Zeichen. Ohne diese Variable ist /admin gesperrt.
ADMIN_PASSWORD=
# Optional: zusätzlicher geheimer Schlüssel für Anmeldung und anonyme Besucherzählung (lange Zufallszeichenkette)
# ADMIN_SECRET=

# Optional: Bestätigungscode aus der Google Search Console (nur der Code aus content="…")
# GOOGLE_SITE_VERIFICATION=
